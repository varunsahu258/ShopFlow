{
  "__inputs": [{ "name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus" }],
  "title": "ShopFlow E-Commerce Dashboard",
  "uid": "shopflow-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Orders",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(orders_total)",
        "legendFormat": "Total Orders",
        "datasource": { "type": "prometheus" }
      }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "yellow", "value": 100 },
        { "color": "red", "value": 1000 }
      ] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Completed Orders",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(orders_total{status=\"completed\"})",
        "legendFormat": "Completed"
      }],
      "options": { "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" } } }
    },
    {
      "id": 3, "type": "stat", "title": "Failed Orders",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(orders_total{status=\"failed\"}) or vector(0)",
        "legendFormat": "Failed"
      }],
      "options": { "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red", "mode": "fixed" } } }
    },
    {
      "id": 4, "type": "stat", "title": "Active Users",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "active_users_total", "legendFormat": "Active Users" }],
      "options": { "colorMode": "background" }
    },
    {
      "id": 5, "type": "stat", "title": "Avg Response Time",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m])) * 1000",
        "legendFormat": "p50 ms"
      }],
      "options": { "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "ms",
        "thresholds": { "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 300 },
          { "color": "red", "value": 1000 }
        ] }
      } }
    },
    {
      "id": 6, "type": "stat", "title": "Error Rate",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / sum(rate(http_request_duration_seconds_count[5m])) * 100",
        "legendFormat": "Error %"
      }],
      "options": { "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent",
        "thresholds": { "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red", "value": 5 }
        ] }
      } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Order Throughput (per minute)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(orders_total{status=\"completed\"}[1m]) * 60", "legendFormat": "Completed/min" },
        { "expr": "rate(orders_total{status=\"failed\"}[1m]) * 60",    "legendFormat": "Failed/min" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Failed/min" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 8, "type": "timeseries", "title": "HTTP Response Times (p50 / p95 / p99)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "HTTP Request Rate by Status",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"2..\"}[5m])) by (route)", "legendFormat": "2xx {{route}}" },
        { "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"4..\"}[5m])) by (route)", "legendFormat": "4xx {{route}}" },
        { "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) by (route)", "legendFormat": "5xx {{route}}" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Node.js Memory Usage",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "process_heap_bytes",                     "legendFormat": "Heap Used" },
        { "expr": "process_resident_memory_bytes",          "legendFormat": "RSS" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Event Loop Lag",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "targets": [
        { "expr": "nodejs_eventloop_lag_mean_seconds * 1000", "legendFormat": "Mean lag ms" },
        { "expr": "nodejs_eventloop_lag_p99_seconds * 1000",  "legendFormat": "p99 lag ms" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms",
        "thresholds": { "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 10 },
          { "color": "red", "value": 100 }
        ] }
      } }
    },
    {
      "id": 12, "type": "timeseries", "title": "Active DB Connections",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "targets": [
        { "expr": "nodejs_active_handles_total", "legendFormat": "Active handles" }
      ]
    }
  ]
}
